<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>جراده - Garradah</title>
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #2a2a2a;
            --button-bg: #4a4a4a;
            --button-hover: #606060;
            --text-color: #ffffff;
            --accent-color: #888888;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 600px;
            text-align: center;
        }

        .header {
            margin-bottom: 20px;
        }

        .header h1 {
            font-size: 2.5rem;
            margin: 10px 0 5px 0;
            letter-spacing: 1px;
        }

        .header p {
            color: var(--accent-color);
            margin: 0;
            font-size: 0.9rem;
        }

        .profile-img-container {
            width: 100%;
            max-width: 350px;
            margin: 0 auto 25px auto;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0,0,0,0.6);
            border: 2px solid #333;
        }

        .profile-img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* شبكة الأزرار الستة */
        .buttons-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .btn {
            background-color: var(--button-bg);
            color: white;
            text-decoration: none;
            padding: 18px 10px;
            border-radius: 12px;
            font-weight: bold;
            font-size: 1rem;
            transition: background-color 0.2s ease, transform 0.1s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #555;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            cursor: pointer;
        }

        .btn:active {
            transform: scale(0.98);
            background-color: var(--button-hover);
        }

        /* المنطقة الخاصة بالإدارة (غير مرئية للزوار العاديين) */
        .admin-section {
            margin-top: 20px;
            padding: 15px;
            background-color: #1e1e1e;
            border-radius: 10px;
            border: 1px dashed #444;
        }

        .admin-toggle-btn {
            background: none;
            border: none;
            color: #555;
            font-size: 0.8rem;
            cursor: pointer;
            text-decoration: underline;
        }

        .admin-content {
            display: none;
            margin-top: 15px;
        }

        .admin-content input[type="file"], 
        .admin-content input[type="password"] {
            margin: 10px 0;
            padding: 8px;
            width: 80%;
            border-radius: 5px;
            border: 1px solid #444;
            background: #222;
            color: white;
        }

        footer {
            margin-top: auto;
            padding: 20px 0 10px 0;
            color: #666;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- الهيدر اسم الموقع -->
        <div class="header">
            <h1>جراده</h1>
            <p>العاب وتطبيقات APK & IPA</p>
        </div>

        <!-- صورة الموقع -->
        <div class="profile-img-container">
            <!-- استبدل رابط الصورة أدناه برابط صورتك الشخصية -->
            <img class="profile-img" src="https://via.placeholder.com/400x400/111111/ffffff?text=Garradah" alt="صورة الموقع">
        </div>

        <!-- الخيارات الستة باللون الرصاصي -->
        <div class="buttons-grid">
            <a href="#ipa-apps" class="btn">تطبيقات ipa</a>
            <a href="#ipa-games" class="btn">العاب ipa</a>
            <a href="#apk-apps" class="btn">تطبيقات apk</a>
            <a href="#apk-games" class="btn">العاب apk</a>
            <a href="#accounts" class="btn">حساباتي</a>
            <a href="#suggestions" class="btn">اقتراحاتكم</a>
        </div>

        <!-- الخيار الخاص بك (لوحة إدارة رفع الملفات) -->
        <div class="admin-section">
            <button class="admin-toggle-btn" onclick="openAdmin()">دخول الإدارة (خاص)</button>
            <div id="adminContent" class="admin-content">
                <p style="font-size: 0.9rem; color: #aaa;">تحميل ورفع ملفات IPA / APK</p>
                <input type="file" id="fileInput" accept=".apk,.ipa"><br>
                <button class="btn" style="padding: 8px 15px; font-size: 0.8rem; margin: 0 auto;" onclick="uploadFile()">رفع الملف</button>
                <p id="uploadStatus" style="font-size: 0.8rem; color: #4CAF50;"></p>
            </div>
        </div>
    </div>

    <footer>
        &copy; جميع الحقوق محفوظة لموقع جراده
    </footer>

    <script>
        function openAdmin() {
            const password = prompt("أدخل كلمة المرور لدخول لوحة رفع الملفات:");
            // كلمة المرور الافتراضية هي 1234
            if (password === "Kk11223344556677889900") {
                document.getElementById("adminContent").style.display = "block";
                alert("تم تسجيل الدخول بنجاح.");
            } else if (password !== null) {
                alert("كلمة المرور غير صحيحة!");
            }
        }

        function uploadFile() {
            const fileInput = document.getElementById("fileInput");
            if (fileInput.files.length > 0) {
                document.getElementById("uploadStatus").innerText = "تم اختيار الملف: " + fileInput.files[0].name;
            } else {
                alert("jarada.");
            }
        }
    </script>
</body>
</html>
